<h1 class="h4 mb-4">Settings</h1>

<%= form_with url: settings_path, method: :patch do %>
  <div class="card mb-4">
    <div class="card-header">ntfy server</div>
    <div class="card-body form-narrow">
      <div class="mb-3">
        <label for="ntfy_url" class="form-label">Server URL</label>
        <input type="text" id="ntfy_url" name="ntfy[url]" class="form-control" value="<%= @settings.ntfy_url %>" placeholder="https://ntfy.sh">
      </div>
      <div class="mb-3">
        <label for="ntfy_topic" class="form-label">Topic</label>
        <input type="text" id="ntfy_topic" name="ntfy[topic]" class="form-control" value="<%= @settings.ntfy_topic %>" placeholder="scoredrop">
      </div>
      <div class="mb-3">
        <label for="ntfy_token" class="form-label">Access token (optional)</label>
        <input type="password" id="ntfy_token" name="ntfy[token]" class="form-control" value="<%= @settings.ntfy_token %>" autocomplete="off">
      </div>
      <div class="mb-3">
        <label for="ntfy_priority" class="form-label">Default priority (1-5)</label>
        <input type="number" id="ntfy_priority" name="ntfy[priority]" class="form-control" min="1" max="5" value="<%= @settings.ntfy_priority %>">
      </div>
      <button type="submit" formaction="<%= test_ntfy_settings_path %>" formmethod="post"
              class="btn btn-outline-secondary btn-sm">Check connection</button>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">Notifications</div>
    <div class="card-body form-narrow">
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="n_start" name="notify[start]" value="1" <%= "checked" if @settings.notify_start %>>
        <label class="form-check-label" for="n_start">Match start (kickoff)</label>
      </div>
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="n_goals" name="notify[goals]" value="1" <%= "checked" if @settings.notify_goals %>>
        <label class="form-check-label" for="n_goals">Goals</label>
      </div>
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="n_ft" name="notify[fulltime]" value="1" <%= "checked" if @settings.notify_fulltime %>>
        <label class="form-check-label" for="n_ft">Fulltime</label>
      </div>
      <div class="mt-3 mb-0">
        <label for="remind" class="form-label">Reminder before kickoff (min, 0 = off)</label>
        <input type="number" id="remind" name="remind_minutes_before" class="form-control" min="0" value="<%= @settings.remind_minutes_before %>">
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">Polling</div>
    <div class="card-body form-narrow">
      <div class="mb-3">
        <label for="poll" class="form-label">Live poll interval (sec)</label>
        <input type="number" id="poll" name="poll_interval_seconds" class="form-control" min="30" value="<%= @settings.poll_interval_seconds %>">
      </div>
      <div class="mb-3">
        <label for="idle" class="form-label">Idle poll interval (sec)</label>
        <input type="number" id="idle" name="idle_poll_interval_seconds" class="form-control" min="60" value="<%= @settings.idle_poll_interval_seconds %>">
      </div>
      <div class="mb-0">
        <label for="window" class="form-label">Pre-kickoff fast-poll window (sec)</label>
        <input type="number" id="window" name="live_window_seconds" class="form-control" min="0" value="<%= @settings.live_window_seconds %>">
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-success">Save</button>
<% end %>

<p class="text-secondary small mt-3">Changes take effect on the next poll cycle — no restart needed.</p>
